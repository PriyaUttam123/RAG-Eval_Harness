# ==============================================================================
# RAG Evaluation Harness — Environment Variable Configuration Template
# Copy this file to '.env' and fill in the values. NEVER commit '.env' to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# NVIDIA Nemotron LLM API (OpenAI-Compatible Endpoint)
# ------------------------------------------------------------------------------
NVIDIA_API_KEY=your_nvidia_api_key_here
NEMOTRON_MODEL=nvidia/nemotron-4-340b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ------------------------------------------------------------------------------
# Embedding Model Configuration
# ------------------------------------------------------------------------------
# Local Sentence-Transformers model name or HuggingFace identifier
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# ------------------------------------------------------------------------------
# Vector Store (ChromaDB) Configuration
# ------------------------------------------------------------------------------
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=rag_eval_docs

# ------------------------------------------------------------------------------
# Optional Relational Persistence (PostgreSQL for Experiment History)
# ------------------------------------------------------------------------------
# Leave empty if using file-based experiment logging during MVP
DATABASE_URL=postgresql://user:password@localhost:5432/rag_eval_harness

# ------------------------------------------------------------------------------
# Server & Client Configuration
# ------------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173
ENVIRONMENT=development
LOG_LEVEL=INFO
