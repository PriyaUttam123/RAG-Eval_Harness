# ==============================================================================
# RAG Evaluation Harness — Backend Environment Configuration Template
# Copy this file to '.env' for local configuration. NEVER commit '.env' to git.
# ==============================================================================

# Application Information
PROJECT_NAME="RAG Evaluation Harness"
VERSION="0.1.0"

# Server Network Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Runtime Environment (development, staging, production)
ENVIRONMENT=development
LOG_LEVEL=INFO

# Cross-Origin Resource Sharing (CORS) Allowlist
# Accepts comma-separated URLs or JSON array string
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Document Ingestion Security Constraints
MAX_FILE_SIZE_BYTES=10485760

# Document Chunking Configuration
DEFAULT_CHUNK_SIZE=512
DEFAULT_CHUNK_OVERLAP=50

# Embedding & Vector Storage Configuration
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=rag_eval_chunks
CHROMA_DISTANCE_METRIC=cosine
DEFAULT_RETRIEVAL_K=4

# ------------------------------------------------------------------------------
# Note: Model credentials, embedding configurations, vector store directories,
# and database URLs will be introduced in subsequent phases as those components
# are implemented.
# ------------------------------------------------------------------------------
